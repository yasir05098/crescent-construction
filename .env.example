# ====================================
# ENVIRONMENT VARIABLES
# Copy this file to .env and fill in your actual values
# ====================================

# Server Configuration
PORT=3000
NODE_ENV=development

# ====================================
# GMAIL CONFIGURATION (For Email Sending)
# ====================================
# 1. Enable 2-Factor Authentication on your Google Account
# 2. Generate an App Password at: https://myaccount.google.com/apppasswords
# 3. Use the 16-character password below (remove spaces)

GMAIL_USER=your-email@gmail.com
GMAIL_PASSWORD=your-16-character-app-password

# ====================================
# TWILIO CONFIGURATION (For WhatsApp)
# ====================================
# Get these from: https://www.twilio.com/console
# 1. Sign up at Twilio (free account with credits)
# 2. Get Account SID and Auth Token from dashboard
# 3. Set up WhatsApp Sandbox or Business Account
# 4. Get your Twilio WhatsApp number

TWILIO_ACCOUNT_SID=your-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_WHATSAPP_NUMBER=+1234567890

# ====================================
# EMAIL RECIPIENT (Admin)
# ====================================
# Where quote submissions will be sent
ADMIN_EMAIL=crescentconstructiontvl@gmail.com
